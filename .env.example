# ==============================================================================
# DevSecOps PoC Monorepo - Root Environment Variables Template
# Copy this file to .env before running Docker Compose in production-like mode.
# ==============================================================================

# Identity Service (Django)
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,identity-service,web,dashboard

# Common Ports
WEB_PORT=3000
DASHBOARD_PORT=4200
IDENTITY_PORT=8001
ORDERS_PORT=8002
NOTIFICATION_PORT=8003
