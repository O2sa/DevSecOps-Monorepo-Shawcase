# ==============================================================================
# Identity Service - Environment Variables Template
# Copy this file to .env for local overrides (do not commit real .env files).
# ==============================================================================

# Security Configuration
# In production (DJANGO_DEBUG=False), DJANGO_SECRET_KEY is strictly required.
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,identity-service,0.0.0.0

# Service Port
PORT=8001

# Database Configuration (Future PostgreSQL preparation)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=identity_db
# DB_USER=identity_user
# DB_PASSWORD=identity_password
# DB_HOST=localhost
# DB_PORT=5432

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
